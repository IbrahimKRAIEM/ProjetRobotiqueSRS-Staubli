<?xml version="1.0" encoding="utf-8" ?>
<Programs xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://www.staubli.com/robotics/VAL3/Program/2" >
  <Program name="exercice2" access="private" >
    <Code><![CDATA[begin
  movej(jDepart,tPince,mRapide)
  call ouvrirPince()
  movej(appro(Prise5[0],{0,0,-50,0,0,0}),tPince,mRapide)
  movel(Prise5[0],tPince,mLent)
  call fermerPince()
  movel(appro(Prise5[0],{0,0,-50,0,0,0}),tPince,mRapide)

  movej(jDepart,tPince,mRapide)
  movej(appro(pDepose[0],{0,0,-50,0,0,0}),tPince,mRapide)
  movel(pDepose[0],tPince,mLent)
  call ouvrirPince()
  movel(appro(pDepose,{0,0,-50,0,0,0}),tPince,mRapide)

  movej(jDepart,tPince,mLent)

  waitEndMove()
end]]></Code>
  </Program>
</Programs>